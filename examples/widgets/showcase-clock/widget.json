{
  "id": "dev.lifedashboard.showcase.clock",
  "version": "1.1.0",
  "title": "Analog clock",
  "author": "LifeDashboard",
  "entry": "index.js",
  "styles": [
    "style.css"
  ],
  "frame": "frameless",
  "sizing": {
    "default": {
      "w": 6,
      "h": 6
    },
    "min": {
      "w": 3,
      "h": 3
    },
    "max": {
      "w": 10,
      "h": 10
    }
  },
  "permissions": [],
  "variants": {
    "default": "classic",
    "items": [
      {
        "id": "classic",
        "title": "Classic"
      },
      {
        "id": "minimal",
        "title": "Minimal"
      },
      {
        "id": "roman",
        "title": "Roman numerals"
      }
    ]
  },
  "settings": {
    "type": "object",
    "properties": {
      "zone": {
        "type": "string",
        "title": "Time zone",
        "default": "UTC",
        "maxLength": 64
      }
    }
  }
}
